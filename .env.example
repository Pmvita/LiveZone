# Server-only. Do not prefix these with EXPO_PUBLIC_.
# Copy this file to .env.local and paste your key there.
# Expo route handlers read it. The React Native app never receives it.
API_SPORTS_KEY=
# Football host only. Basketball and American football use their own API-Sports hosts.
API_SPORTS_BASE_URL=https://v3.football.api-sports.io
# Upstream API-Sports calls allowed per UTC day. Default 80, under the free plan's 100.
API_SPORTS_DAILY_LIMIT=80
