{
  "expo": {
    "name": "LiveZone",
    "slug": "livezone",
    "scheme": "livezone",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07111F",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "apiRoutes": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "apiRoutes": true,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ef81a593-28b6-48c9-8e2e-4bf3d96fee7b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ef81a593-28b6-48c9-8e2e-4bf3d96fee7b"
    }
  }
}
